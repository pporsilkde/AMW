#version 430 core

layout(local_size_x = @workGroupSize, local_size_y = 1, local_size_z = 1) in;

struct MagnusPointLight
{
    vec4 position;
    vec4 diffuse;
    vec4 ambient;
    vec4 specular;
    float constant;
    float linear;
    float quadratic;
    float radius;
};
struct MagnusLightGrid { uint offset; uint count; };
struct MagnusCluster { vec4 minPoint; vec4 maxPoint; };

layout(std430, binding = 1) restrict buffer MagnusClusterSSBO { MagnusCluster magnusClusters[]; };
layout(std430, binding = 2) restrict buffer MagnusPointLightSSBO { MagnusPointLight magnusPointLights[]; };
layout(std430, binding = 3) restrict buffer MagnusLightGridSSBO { MagnusLightGrid magnusLightGridBuffer[]; };
layout(std430, binding = 4) restrict buffer MagnusLightIndexListSSBO { uint magnusLightIndexList[]; };
layout(std430, binding = 5) restrict buffer MagnusLightIndexCounterSSBO { uint magnusGlobalLightIndexCount; };

shared MagnusCluster gCluster;
shared uint gCount;
shared uint gOffset;
shared uint gList[@maxLightsPerCluster];

bool sphereAABBIntersection(vec3 center, float radius, vec3 aabbMin, vec3 aabbMax)
{
    vec3 closestPoint = clamp(center, aabbMin, aabbMax);
    vec3 delta = closestPoint - center;
    return dot(delta, delta) <= radius * radius;
}

void main()
{
    if (gl_LocalInvocationIndex == 0u)
    {
        gCount = 0u;
        gCluster = magnusClusters[gl_WorkGroupID.x];
    }
    barrier();

    for (uint i = gl_LocalInvocationIndex; i < magnusPointLights.length(); i += @workGroupSize)
    {
        MagnusPointLight light = magnusPointLights[i];
        if (light.radius <= 0.0)
            continue;
        // X007: overlap neighbouring clusters slightly. This prevents a local
        // light from disappearing for a frame while camera rotation moves a
        // fragment across a tile/depth boundary. Actual attenuation is unchanged.
        vec3 clusterExtent = max(gCluster.maxPoint.xyz - gCluster.minPoint.xyz, vec3(0.0));
        vec3 clusterPadding = max(vec3(2.0), clusterExtent * 0.04);
        if (sphereAABBIntersection(light.position.xyz, light.radius,
                gCluster.minPoint.xyz - clusterPadding, gCluster.maxPoint.xyz + clusterPadding))
        {
            uint index = atomicAdd(gCount, 1u);
            if (index < uint(@maxLightsPerCluster))
                gList[index] = i;
        }
    }
    barrier();

    if (gl_LocalInvocationIndex == 0u)
    {
        gCount = min(gCount, uint(@maxLightsPerCluster));
        gOffset = atomicAdd(magnusGlobalLightIndexCount, gCount);
        magnusLightGridBuffer[gl_WorkGroupID.x] = MagnusLightGrid(gOffset, gCount);
    }
    barrier();

    for (uint i = gl_LocalInvocationIndex; i < gCount; i += @workGroupSize)
        magnusLightIndexList[gOffset + i] = gList[i];
}
