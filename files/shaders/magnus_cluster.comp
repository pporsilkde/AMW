#version 430 core

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

struct MagnusCluster
{
    vec4 minPoint;
    vec4 maxPoint;
};
layout(std430, binding = 1) restrict buffer MagnusClusterSSBO { MagnusCluster magnusClusters[]; };

uniform float magnusNear;
uniform mat4 magnusInverseProjectionMatrix;
uniform vec3 magnusGridSize;
uniform vec2 magnusScreenRes;
uniform float magnusClusterFar;

vec3 lineIntersectionWithZPlane(vec3 startPoint, vec3 endPoint, float zDistance)
{
    vec3 direction = endPoint - startPoint;
    vec3 normal = vec3(0.0, 0.0, -1.0);
    float t = (zDistance - dot(normal, startPoint)) / dot(normal, direction);
    return startPoint + t * direction;
}

vec3 screenToView(vec2 screenCoord)
{
    vec4 ndc = vec4(screenCoord / magnusScreenRes * 2.0 - 1.0, -1.0, 1.0);
    vec4 viewCoord = magnusInverseProjectionMatrix * ndc;
    viewCoord /= viewCoord.w;
    return viewCoord.xyz;
}

void main()
{
    uint tileIndex = gl_WorkGroupID.x
        + gl_WorkGroupID.y * uint(magnusGridSize.x)
        + gl_WorkGroupID.z * uint(magnusGridSize.x) * uint(magnusGridSize.y);
    vec2 tileSize = magnusScreenRes / magnusGridSize.xy;

    vec2 minTileScreen = gl_WorkGroupID.xy * tileSize;
    vec2 maxTileScreen = (gl_WorkGroupID.xy + uvec2(1u)) * tileSize;
    vec3 minTile = screenToView(minTileScreen);
    vec3 maxTile = screenToView(maxTileScreen);

    float safeNear = max(magnusNear, 0.001);
    float safeFar = max(magnusClusterFar, safeNear + 0.001);
    float planeNear = safeNear * pow(safeFar / safeNear, float(gl_WorkGroupID.z) / magnusGridSize.z);
    float planeFar = safeNear * pow(safeFar / safeNear, float(gl_WorkGroupID.z + 1u) / magnusGridSize.z);

    vec3 minPointNear = lineIntersectionWithZPlane(vec3(0.0), minTile, planeNear);
    vec3 minPointFar = lineIntersectionWithZPlane(vec3(0.0), minTile, planeFar);
    vec3 maxPointNear = lineIntersectionWithZPlane(vec3(0.0), maxTile, planeNear);
    vec3 maxPointFar = lineIntersectionWithZPlane(vec3(0.0), maxTile, planeFar);

    magnusClusters[tileIndex].minPoint = vec4(min(minPointNear, minPointFar), 0.0);
    magnusClusters[tileIndex].maxPoint = vec4(max(maxPointNear, maxPointFar), 0.0);
}
