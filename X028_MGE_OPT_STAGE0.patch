+        result.mPositions.reserve(static_cast<std::size_t>(coarsePerSide * coarsePerSide));
+        for (int cj = 0; cj < coarsePerSide; ++cj)
+        {
+            for (int ci = 0; ci < coarsePerSide; ++ci)
+            {
+                float minH = std::numeric_limits<float>::max();
+                for (int dj = -1; dj <= 0; ++dj)
